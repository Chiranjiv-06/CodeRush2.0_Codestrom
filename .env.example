# M2X Compute & Tool Exchange — runtime configuration.
# Copy to `.env`; every value below is a default, not a requirement.

# --------------------------------------------------------------------------- #
# Payment asset
# --------------------------------------------------------------------------- #
# The exchange quotes, escrows, settles and refunds in exactly one Algorand
# Standard Asset. Changing ALGORAND_ASSET_ID is an administrative act: quotes,
# escrows and receipts written under the old id are not migrated, and payments
# naming any other asset are rejected at verification.
ALGORAND_NETWORK=testnet
ALGORAND_ASSET_ID=10458941

# Real on-chain settlement (optional). Without ALGOD_URL the built-in escrow
# ledger settles instead, using the same asset id.
M2X_ALGOD_URL=
M2X_ALGOD_TOKEN=
M2X_ALGORAND_DISPENSER_MNEMONIC=
M2X_X402_SETTLEMENT_BACKEND=auto        # auto | algorand | ledger

# --------------------------------------------------------------------------- #
# x402
# --------------------------------------------------------------------------- #
# The x402 network ("algorand-testnet") and asset ("10458941") are derived from
# the two variables above and cannot be set independently.
M2X_X402_FACILITATOR_URL=               # empty -> built-in local facilitator
M2X_X402_ESCROW_TIMEOUT_SECONDS=900

# --------------------------------------------------------------------------- #
# Bazaar discovery
# --------------------------------------------------------------------------- #
M2X_BAZAAR_ENABLED=true
M2X_BAZAAR_BASE_URL=https://bazaar.goplausible.xyz
M2X_BAZAAR_LIST_PATH=/api/v1/x402/list

# --------------------------------------------------------------------------- #
# Zerion Onchain Intelligence (external provider)
# --------------------------------------------------------------------------- #
# Zerion is registered on this exchange as a normal provider. The consumer still
# pays the exchange in the Algorand ASA above; the exchange then pays Zerion on
# Zerion's own rail. The two rails are independent — configuring Zerion changes
# nothing about Algorand settlement.
ZERION_ENABLED=true
ZERION_API_BASE_URL=https://api.zerion.io

# --- payment rail A: API key (no per-request payment) ---
# Free key from https://dashboard.zerion.io — starts with `zk_`.
# NEVER commit a real key. Leave empty here; set it in `.env` only.
ZERION_API_KEY=

# --- payment rail B: Zerion x402 (pay-per-request, USDC on Base or Solana) ---
# No Zerion API key required. Set ZERION_USE_X402=true *and* at least one key.
# NEVER commit a real private key. The exchange never sends these to the
# frontend, never stores them in the database and never logs them.
ZERION_USE_X402=false
ZERION_EVM_PRIVATE_KEY=
ZERION_SOLANA_PRIVATE_KEY=
ZERION_X402_PREFER_SOLANA=false

# Transport: auto picks the Zerion CLI when it is installed and x402 is the
# active rail (the CLI signs and retries for us), otherwise the HTTP API.
ZERION_TRANSPORT=auto                   # auto | api | cli
ZERION_CLI_COMMAND=zerion
ZERION_TIMEOUT_SECONDS=15
ZERION_MAX_RETRIES=2
ZERION_DEFAULT_CHAIN=ethereum
ZERION_ALLOWED_CHAINS=                  # empty -> every chain Zerion supports
ZERION_CURRENCY=usd
ZERION_HISTORY_LIMIT=20

# With no credential configured, demo mode serves deterministic fixture data so
# the full discover -> quote -> pay -> call -> verify -> receipt path still runs
# on a bare machine. Results are labelled `source: zerion_demo` and the receipt
# records that no external payment settled.
ZERION_DEMO_MODE=true

# --- quotas & cost control ---
ZERION_MAX_REQUESTS_PER_JOB=5
ZERION_MAX_REQUESTS_PER_SESSION=25
ZERION_MAX_SPEND_MICROS=2000000         # per principal, per window
ZERION_QUOTA_WINDOW_SECONDS=3600
ZERION_COST_MICROS=10000                # what one Zerion x402 call costs us (0.01 USDC)
ZERION_PRICE_MICROS=15000               # what the exchange charges the consumer
ZERION_RESULT_TTL_SECONDS=86400

# --------------------------------------------------------------------------- #
# API & security
# --------------------------------------------------------------------------- #
M2X_ENV=local
M2X_HOST=0.0.0.0
M2X_PORT=8000
M2X_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
M2X_JWT_SECRET=change-me-to-a-long-random-string
M2X_RECEIPT_SIGNING_KEY=change-me-too
M2X_PAYMENT_SHARED_SECRET=change-me-as-well

# --------------------------------------------------------------------------- #
# Datastores & workers (all optional; local fallbacks are used when unset)
# --------------------------------------------------------------------------- #
M2X_DATABASE_URL=                       # empty -> sqlite in var/
M2X_REDIS_URL=                          # empty -> in-process cache
M2X_MINIO_ENDPOINT=                     # empty -> local artifact storage
M2X_SANDBOX_BACKEND=auto                # auto | docker | subprocess
M2X_LOG_LEVEL=INFO
