# M2X Compute & Tool Exchange — runtime configuration.
# Copy to `.env`; every value below is a default, not a requirement.

# --------------------------------------------------------------------------- #
# Payment asset
# --------------------------------------------------------------------------- #
# The exchange quotes, escrows, settles and refunds in exactly one Algorand
# Standard Asset. Changing ALGORAND_ASSET_ID is an administrative act: quotes,
# escrows and receipts written under the old id are not migrated, and payments
# naming any other asset are rejected at verification.
ALGORAND_NETWORK=testnet
ALGORAND_ASSET_ID=10458941

# Real on-chain settlement (optional). Without ALGOD_URL the built-in escrow
# ledger settles instead, using the same asset id.
M2X_ALGOD_URL=
M2X_ALGOD_TOKEN=
M2X_ALGORAND_DISPENSER_MNEMONIC=
M2X_X402_SETTLEMENT_BACKEND=auto

# --------------------------------------------------------------------------- #
# x402
# --------------------------------------------------------------------------- #
# The x402 network ("algorand-testnet") and asset ("10458941") are derived from
# the two variables above and cannot be set independently.
M2X_X402_FACILITATOR_URL=
M2X_X402_ESCROW_TIMEOUT_SECONDS=900

# --------------------------------------------------------------------------- #
# Bazaar discovery
# --------------------------------------------------------------------------- #
M2X_BAZAAR_ENABLED=true
M2X_BAZAAR_BASE_URL=https://bazaar.goplausible.xyz
M2X_BAZAAR_LIST_PATH=/api/v1/x402/list

# --------------------------------------------------------------------------- #
# API & security
# --------------------------------------------------------------------------- #
M2X_ENV=local
M2X_HOST=0.0.0.0
M2X_PORT=8000
M2X_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
M2X_JWT_SECRET=change-me-to-a-long-random-string
M2X_RECEIPT_SIGNING_KEY=change-me-too
M2X_PAYMENT_SHARED_SECRET=change-me-as-well

# --------------------------------------------------------------------------- #
# Datastores & workers (all optional; local fallbacks are used when unset)
# --------------------------------------------------------------------------- #
M2X_DATABASE_URL=
M2X_REDIS_URL=
M2X_MINIO_ENDPOINT=
M2X_SANDBOX_BACKEND=auto
M2X_LOG_LEVEL=INFO
